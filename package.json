{
  "name": "stackbox",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "generate": "pnpm --filter @stackbox/contract generate",
    "test:run": "pnpm -r --workspace-concurrency=1 test:run",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "e2e": "pnpm --filter @stackbox/e2e test"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "eslint": "^9.25.0",
    "globals": "^16.0.0",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.30.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@swc/core", "esbuild", "msw"]
  }
}
