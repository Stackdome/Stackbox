DATABASE_URL=postgres://postgres:postgres@localhost:5433/stackbox
# Used by apps/api/test/migrate.spec.ts and e2e: postgres://postgres:postgres@localhost:5433/stackbox_test

# HS256 signing key for access and refresh tokens, at least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-32-chars

# The reconciler ticks every 2 seconds unless this is false.
RECONCILER_ENABLED=true
# scripted (default) or openai; openai also needs OPENAI_API_KEY and OPENAI_MODEL.
AGENT_RUNTIME=scripted
